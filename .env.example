PORT=3000
NODE_ENV=production

# 資料庫
DATABASE_URL=
# 只有在資料庫使用自簽憑證且無法提供 CA 時才設為 true（會停用 TLS 憑證驗證）
DATABASE_SSL_INSECURE=

# 登入 Session 簽章金鑰（必填，建議 32 字元以上的隨機字串）
# 產生方式：node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# 首次部署時建立的管理員帳號（密碼必填且至少 6 字元，否則不會建立帳號）
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=

# 設為 true 時，啟動會把上方密碼強制寫回既有管理員帳號（用於輪替舊的弱密碼）。
# 輪替完成後請改回 false，避免每次部署都重設密碼。
DEFAULT_ADMIN_PASSWORD_ROTATE=false

# 舊版管理金鑰，僅在 SESSION_SECRET 未設定時作為簽章金鑰備援（建議改用 SESSION_SECRET）
ADMIN_KEY=

# Meta Marketing API
META_ACCESS_TOKEN=
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v26.0

# 啟動時是否自動從 Meta 匯入廣告帳號（預設 false，可改用 POST /api/admin/bootstrap-meta）
BOOTSTRAP_META_ON_START=false
